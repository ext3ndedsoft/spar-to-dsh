{
  "name": "dsh-plugin-spar",
  "version": "2.1.0",
  "private": true,
  "description": "A second model that argues back: adversarial debates between the calling agent and another provider route, judged in a clean context and rendered as its own voice in the web client",
  "type": "module",
  "main": "./plugins/spar/index.js",
  "exports": {
    ".": "./plugins/spar/index.js",
    "./client": "./plugins/spar/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins/spar/index.js",
    "plugins/spar/client.js",
    "plugins/spar/tools.js",
    "plugins/spar/live.js",
    "plugins/spar/settings.js",
    "plugins/spar/README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node plugins/spar/test.mjs",
    "smoke": "node plugins/spar/smoke-client.cjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "debate",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ext3ndedsoft/spar-to-dsh.git"
  },
  "homepage": "https://github.com/ext3ndedsoft/spar-to-dsh#readme"
}
